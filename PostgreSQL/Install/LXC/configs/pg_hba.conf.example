# Example additions for /etc/postgresql/18/main/pg_hba.conf
#
# Keep the Debian-generated local/loopback rules and add only the remote
# rules that are appropriate for your environment.

# TLS-only access from the VM subnet.
hostssl    labdb    labuser    10.10.254.0/24       scram-sha-256

# TLS-only access from one administrator/test workstation.
hostssl    labdb    labuser    10.10.101.108/32    scram-sha-256

# Prefer explicit /32 entries for Internet clients whenever their public
# source IPs are stable. Do not use "trust" for remote access.
