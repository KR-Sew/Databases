# PostgreSQL network/TLS settings used by this lab.
# Merge these settings into /etc/postgresql/18/main/postgresql.conf.

listen_addresses = 'localhost,10.10.205.101'
port = 5432

ssl = on
ssl_cert_file = '/etc/postgresql/ssl/server.crt'
ssl_key_file = '/etc/postgresql/ssl/server.key'

# ssl_ca_file is not required merely to present a server certificate.
# Configure it only when the server needs a CA file for features such as
# client-certificate verification.
